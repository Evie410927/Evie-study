{
  "schemaVersion": 1,
  "contractVersion": "2026-09-29.20",
  "authority": {
    "qualityContract": "config/quality-contract.json",
    "architecture": "docs/architecture.md",
    "dataContract": "docs/data-contract.md",
    "decisions": [
      "docs/decisions/ADR-001-pagination-layout.md",
      "docs/decisions/ADR-002-review-order.md",
      "docs/decisions/ADR-003-mobile-durable-snapshot-recovery.md",
      "docs/decisions/ADR-004-similar-word-manual-order.md",
      "docs/decisions/ADR-005-inline-memory-note.md"
    ]
  },
  "mirroredApps": [
    "standalone_kr_vocab.html",
    "standalone_jp_vocab.html"
  ],
  "allowedLanguageDifferences": [
    "language data",
    "speech locale",
    "storage and cloud language keys",
    "JP krMeaning field and badge"
  ],
  "uiContracts": {
    "pagination": {
      "id": "paginationBar",
      "parentId": "tab-list",
      "previousSiblingId": "wordList",
      "class": "word-list-inline-pagination",
      "inlineStyle": "margin-top: 2px; margin-bottom: 0px;"
    },
    "reviewOrder": {
      "selectId": "reviewRatingSortSelect",
      "default": "createdDesc",
      "allowed": [
        "createdDesc",
        "createdAsc",
        "desc",
        "asc"
      ],
      "automaticSimilarityClustering": false
    },
    "cardActions": {
      "statusPlacement": "card header before rating",
      "footerActions": [
        "speak",
        "edit",
        "delete"
      ],
      "footerContainsStatusToggle": false,
      "partOfSpeechIsCustomTag": false
    },
    "inlinePronunciationNote": {
      "field": "pronunciationNote",
      "independentFrom": "userNote",
      "userNotePurpose": "word-content-explanation",
      "pronunciationNotePurpose": "pronunciation-or-memory-hint",
      "addPlacement": "immediately-after-reading",
      "addControl": "small-plus",
      "addControlPointerDown": "stop-propagation-without-dom-mutation",
      "addControlActivation": "click-opens-inline-editor-without-detail-modal",
      "editor": "in-card-inline-input",
      "editorPlacement": "same-title-row",
      "editorWidth": "flex-to-right-action-boundary",
      "editorOverflow": "soft-wrap-auto-height-without-visible-scrollbars",
      "jpKrMeaningDuringEditing": "temporarily-hidden-to-release-editor-width",
      "initialInputValue": "empty",
      "existingNoteBehavior": "append",
      "existingNoteClick": "prefilled-inline-edit",
      "existingNoteEditBehavior": "replace",
      "fullEditorFieldId": "inputPronunciationNote",
      "fullEditorPlacement": "after-reading-before-meaning",
      "fullEditorControl": "single-line-text-input",
      "fullEditorHeight": "same-as-reading-input",
      "fullEditorNewValue": "empty",
      "fullEditorEditValue": "prefilled-current-pronunciationNote",
      "fullEditorSaveBehavior": "replace",
      "existingNotePointerDown": "stop-propagation-without-dom-mutation",
      "existingNoteActivation": "click-before-opening-editor",
      "contexts": [
        "list-card-title",
        "detail-modal-pronunciation-row"
      ],
      "detailModalPlacement": "dedicated-second-row-above-meaning",
      "detailModalReadingPlacement": "same-dedicated-row-before-note-controls",
      "detailModalWidth": "full-content-row",
      "detailModalAddControlGap": "8px-without-negative-offset",
      "detailModalVisibleContentAlignment": "title-reading-part-of-speech-and-user-note-share-left-edge",
      "detailModalHistoryAlignment": "when-back-button-is-visible-pronunciation-row-aligns-with-word-left-edge",
      "crossContextRefresh": true,
      "displayColor": "soft-apricot-distinct-from-reading-and-user-note",
      "displaySizing": "list-uses-available-title-row-space-until-jp-krMeaning-badge-or-header-actions; detail-uses-full-dedicated-pronunciation-row",
      "fixedDisplayWidthCap": false,
      "automaticTag": "发音",
      "automaticTagWhen": "pronunciationNote-is-non-empty",
      "backfillExistingNotes": true,
      "automaticTagCloudFields": [
        "pronunciationNote",
        "tags"
      ],
      "deleteNoteRemovesAutomaticTag": false,
      "deletePlacement": "note-end",
      "deleteControl": "small-x",
      "directListCardEditing": true,
      "promptDialog": false
    },
    "detailModalScroll": {
      "viewportHeight": "92dvh-with-92vh-fallback",
      "topClearance": "approximately-8-percent-of-viewport",
      "fixedRegion": [
        "title-actions",
        "pronunciation-row",
        "meaning",
        "user-note",
        "tags"
      ],
      "scrollRegionStartsAt": "examples",
      "scrollRegionIncludes": [
        "examples",
        "similar-words"
      ],
      "scrollHostClass": "detail-scroll-content",
      "outerSheetScroll": false
    },
    "requiredWordFields": {
      "fields": [
        "inputWord",
        "inputMeaning",
        "inputPartOfSpeech"
      ],
      "groupClass": "required-field",
      "labelIndicator": "required-badge",
      "labelText": "必填",
      "controlStyle": "soft-rose-dashed-border",
      "focusStyle": "solid-accent-border",
      "optionalFieldsExcluded": true
    }
  },
  "dataContracts": {
    "examples": {
      "generatedEntryMinimum": 3,
      "userMayDeleteAll": true,
      "detailAndReviewShowAllExisting": true
    },
    "similarWords": {
      "mode": "manual-only",
      "bidirectional": true,
      "clearLegacyAutomaticSnapshots": true,
      "conversationContextDoesNotAutoPersist": true,
      "orderStorage": "manualSimilarWordIds-array-order",
      "orderScope": "per-source-word",
      "directCardDrag": true,
      "draftEditorDirectCardDrag": true,
      "draftEditorPersistence": "on-word-save",
      "extraDragButton": false
    },
    "localPersistence": {
      "primary": "localStorage",
      "durableFallback": "IndexedDB",
      "startupSelection": "newest-valid-snapshot",
      "staleNonEmptyPrimaryMustNotBlockFallback": true
    },
    "mainSearch": {
      "krFields": ["word", "reading", "meaning"],
      "jpFields": ["word", "reading", "meaning", "krMeaning"]
    }
  },
  "qualityGate": {
    "command": "python scripts/run_quality_gate.py",
    "requiredChecks": [
      "contract validation",
      "Python syntax compilation",
      "Git whitespace validation",
      "static application assertions",
      "Selenium browser regression for KR and JP",
      "Supabase schema and RLS assertions"
    ]
  }
}
